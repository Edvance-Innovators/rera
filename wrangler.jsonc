{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rera",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RERA_STORE", "class_name": "ReraStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReraStore"] }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://rera.innovatorsedvance.workers.dev",
    "MAIL_FROM": "noreply@edvanceinnovators.org"
  }
}
